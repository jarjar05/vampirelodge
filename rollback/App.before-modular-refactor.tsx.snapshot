  const myTasks = activeTasks.filter((task) => task.owner === "Sarah");

  return (
    <>
      <PageHeading
        showDetails
        eyebrow="Tuesday evening · Household delegation"
        title="Good evening, Sarah"
        description="Here’s where things stand with the household, and what could use your attention tonight."
      />
      <section className="grid grid-cols-2 gap-3 xl:grid-cols-4" aria-label="Care summary">
        <SummaryTile to="/tasks" icon={ClipboardList} label="Active tasks" value={`${activeTasks.length}`} note="Across your family" />
        <SummaryTile to="/appointments" icon={CalendarDays} label="Upcoming appointments" value={`${careAppointments.length}`} note="Next: tomorrow at 10:30" />
        <SummaryTile to="/tasks?filter=Unassigned" icon={UserRound} label="Unassigned task" value={`${unassignedTasks.length}`} note="Needs a family owner" />
        <SummaryTile to="/tasks?filter=Needs%20attention" icon={AlertTriangle} label="Needs attention" value={`${attentionTasks.length}`} note="One item to follow up" />
      </section>

      <div className="mt-5 grid items-start gap-5 xl:grid-cols-[minmax(0,1.35fr)_minmax(280px,0.75fr)]">
        <div className="space-y-5">
          <Card>
            <CardHeader>
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">Care calendar</p>
                <h2 className="mt-1 font-display text-xl font-semibold">Upcoming</h2>
              </div>
              <Link to="/appointments" className="inline-flex shrink-0 items-center gap-1 text-sm font-semibold text-primary hover:underline">
                All appointments <ArrowRight size={15} aria-hidden="true" />
              </Link>
            </CardHeader>
            <CardContent className="divide-y divide-border pt-2">
              {careAppointments.map((appointment) => (
                <article key={appointment.id} className="grid gap-3 py-4 sm:grid-cols-[96px_1fr]">
                  <div className="text-xs font-semibold text-primary">
                    <p>{appointment.date}</p><p className="mt-1 text-foreground">{appointment.time}</p>
                  </div>
                  <div className="min-w-0">
                    <div className="flex flex-wrap items-center gap-x-3 gap-y-1">
                      <h3 className="text-sm font-semibold">{appointment.title}</h3>
                      <span className="text-xs text-muted-foreground">{appointment.person} is going</span>
                    </div>
                    <p className="mt-1 flex items-center gap-1 text-xs text-muted-foreground"><MapPin size={13} aria-hidden="true" />{appointment.place}</p>
                    <p className="mt-2 flex items-center gap-1.5 text-xs text-foreground/75"><ClipboardList size={13} aria-hidden="true" /><span className="font-medium">Related task:</span> {appointment.relatedTask}</p>
                  </div>
                </article>
              ))}
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">Assigned to you</p>
                <h2 className="mt-1 font-display text-xl font-semibold">My tasks</h2>
              </div>
              <Badge variant="secondary">{myTasks.length} active</Badge>
            </CardHeader>
            <CardContent className="pt-2">
              <div className="divide-y divide-border">
                {myTasks.map((task) => <TaskRow key={task.id} task={task} compact />)}
              </div>
              <Link to="/tasks" className="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline">
                View all tasks <ArrowRight size={15} aria-hidden="true" />
              </Link>
            </CardContent>
          </Card>
        </div>

        <div className="space-y-5">
          <Card>
            <CardHeader>
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">Household delegation</p>
                <h2 className="mt-1 font-display text-xl font-semibold">Care Circle</h2>
              </div>
              <Link to="/circle" aria-label="View family" className="flex size-9 items-center justify-center rounded-full text-primary hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
                <ArrowRight size={17} aria-hidden="true" />
              </Link>
            </CardHeader>
            <CardContent className="space-y-4 pt-4">
              {familyMembers.map((member) => (
                <div key={member.name} className="flex items-center gap-3">
