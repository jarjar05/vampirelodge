  { name: "David", activeTasks: 3 },
  { name: "Sarah", activeTasks: 6 },
  { name: "Jason", activeTasks: 2 },
  { name: "Linda", activeTasks: 4 },
];

function AppShell() {
  const [tasks, setTasks] = useState<CareTask[]>(careTasks);
  const [familyName, setFamilyName] = useState(() => window.localStorage.getItem("familyName")?.trim() || "Rivera Family");

  const saveFamilyName = (name: string) => {
    const trimmedName = name.trim();
    if (!trimmedName) return;
    window.localStorage.setItem("familyName", trimmedName);
    setFamilyName(trimmedName);
  };

  return (
    <div className="min-h-screen bg-background text-foreground">
      <aside className="sidebar fixed inset-y-0 left-0 z-10 hidden w-64 flex-col border-r border-border bg-sidebar px-5 py-7 md:flex">
        <Link to="/" aria-label={`${familyName} home`} className="flex min-w-0 items-center gap-3 px-2">
          <span className="flex size-10 items-center justify-center rounded-xl bg-primary text-primary-foreground">
            <HeartHandshake size={21} aria-hidden="true" />
          </span>
          <span className="min-w-0 truncate font-display text-[17px] font-semibold leading-[1.15]">{familyName}</span>
        </Link>

        <div className="mt-8 px-3 text-[11px] font-semibold uppercase tracking-[0.12em] text-muted-foreground">
          Care space
        </div>
        <nav aria-label="Main navigation" className="mt-3 space-y-1">
          {navigation.map(({ to, label, icon: Icon, end }) => (
            <NavLink
              key={to}
              to={to}
              end={end}
              className={({ isActive }) =>
                `flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm font-medium transition-colors ${
                  isActive
                    ? "bg-primary/10 text-primary"
                    : "text-muted-foreground hover:bg-muted hover:text-foreground"
                }`
              }
            >
              <Icon size={18} aria-hidden="true" />
              {label}
            </NavLink>
          ))}
        </nav>

        <div className="mt-auto flex items-center gap-3 border-t border-border px-2 pt-5">
          <FamilyAvatar initials="SR" tone="sage" />
          <div className="min-w-0">
            <p className="truncate text-sm font-semibold">Sarah Rivera</p>
            <p className="text-xs text-muted-foreground">Family member</p>
          </div>
        </div>
      </aside>

      <div className="md:pl-64">
        <header className="flex h-[68px] items-center justify-between border-b border-border bg-background/90 px-5 md:justify-end md:px-10">
          <div className="flex min-w-0 items-center gap-2 md:hidden">
            <HeartHandshake size={20} className="text-primary" aria-hidden="true" />
            <div className="min-w-0">
              <span className="block truncate text-sm font-semibold">{familyName}</span>
            </div>
          </div>
          <div className="flex items-center gap-3">
            <Link
              to="/"
              aria-label="Alerts, one reminder"
              title="Alerts"
              className="relative flex size-9 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            >
              <Bell size={18} aria-hidden="true" />
              <span className="absolute right-2 top-2 size-2 rounded-full bg-alert" />
            </Link>
            <button aria-label="Help" title="Help" className="hidden size-9 items-center justify-center rounded-full text-muted-foreground hover:bg-muted hover:text-foreground sm:flex">
              <CircleHelp size={18} aria-hidden="true" />
            </button>
            <div role="img" aria-label="Sarah Rivera" className="flex size-9 items-center justify-center rounded-full bg-accent text-sm font-semibold text-accent-foreground">
              S
            </div>
          </div>
        </header>
        <main className="mx-auto max-w-6xl px-5 py-8 md:px-10 md:py-11">
          <Routes>
            <Route path="/" element={<OverviewPage tasks={tasks} />} />
            <Route path="/tasks" element={<CarePlanPage tasks={tasks} setTasks={setTasks} />} />
            <Route path="/appointments" element={<AppointmentsPage />} />
            <Route path="/circle" element={<CareCirclePage familyName={familyName} onSaveFamilyName={saveFamilyName} />} />
            <Route path="/activity" element={<ActivityPage />} />
            <Route path="*" element={<OverviewPage tasks={tasks} />} />
          </Routes>
        </main>
      </div>
      <nav aria-label="Main navigation" className="fixed inset-x-0 bottom-0 z-10 flex border-t border-border bg-background px-1 py-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] md:hidden">
        {navigation.map(({ to, mobileLabel, icon: Icon, end }) => (
          <NavLink
            key={to}
            to={to}
            end={end}
            className={({ isActive }) =>
              `flex min-w-0 flex-1 flex-col items-center gap-1 py-1 text-[10px] font-medium leading-tight ${isActive ? "text-primary" : "text-muted-foreground"}`
            }
          >
            <Icon size={19} aria-hidden="true" />
            {mobileLabel}
          </NavLink>
        ))}
      </nav>
    </div>
  );
}

function PageHeading({ title, eyebrow, description, showDetails = false }: { title: string; eyebrow?: string; description?: string; showDetails?: boolean }) {
  return (
    <div className="mb-8">
      {showDetails && eyebrow && <p className="text-xs font-semibold uppercase tracking-[0.12em] text-primary">{eyebrow}</p>}
      <h1 className={`${showDetails ? "mt-2 " : ""}font-display text-3xl font-semibold tracking-tight md:text-4xl`}>{title}</h1>
      {showDetails && description && <p className="mt-2 max-w-2xl text-sm leading-relaxed text-muted-foreground">{description}</p>}
    </div>
  );
}

