function SummaryTile({ to, icon: Icon, label, value, note }: { to: string; icon: typeof CalendarDays; label: string; value: string; note: string }) {
  return (
    <Link to={to} className="flex items-start gap-4 rounded-xl border border-border bg-card p-4 shadow-sm shadow-foreground/[0.025] transition-colors hover:border-primary/40 hover:bg-muted/30 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
      <span className="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent text-accent-foreground">
        <Icon size={19} aria-hidden="true" />
      </span>
      <div>
        <p className="text-xs font-medium text-muted-foreground">{label}</p>
        <p className="mt-1 font-display text-2xl font-semibold">{value}</p>
        <p className="mt-0.5 text-xs text-muted-foreground">{note}</p>
      </div>
    </Link>
  );
}

function getFamilyWorkload(memberName: string) {
  const firstName = memberName.split(" ")[0];
  return familyWorkload.find((member) => member.name === firstName)?.activeTasks ?? 0;
}

function FamilyWorkloadBar({ name, activeTasks }: { name: string; activeTasks: number }) {
  const maxTasks = Math.max(...familyWorkload.map((member) => member.activeTasks));
  return (
    <div className="mt-1.5 flex min-w-0 items-center gap-2">
      <div
        role="progressbar"
        aria-label={`${name} active tasks`}
        aria-valuemin={0}
        aria-valuemax={maxTasks}
        aria-valuenow={activeTasks}
        aria-valuetext={`${activeTasks} active tasks`}
        className="h-1.5 min-w-0 flex-1 overflow-hidden rounded-full bg-muted"
      >
        <div className="h-full rounded-full bg-primary" style={{ width: `${(activeTasks / maxTasks) * 100}%` }} />
      </div>
      <span className="w-4 text-right text-xs font-semibold tabular-nums text-muted-foreground">{activeTasks}</span>
    </div>
  );
}

function getLocalDateInputValue(date = new Date()) {
  return new Date(date.getTime() - date.getTimezoneOffset() * 60_000).toISOString().slice(0, 10);
}

function formatTaskDue(dateValue: string, timeValue: string) {
  const [year, month, day] = dateValue.split("-").map(Number);
  const date = new Date(year, month - 1, day);
  const today = new Date();
  const tomorrow = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
  const dateLabel = date.toDateString() === today.toDateString()
    ? "Today"
    : date.toDateString() === tomorrow.toDateString()
      ? "Tomorrow"
      : new Intl.DateTimeFormat("en", { weekday: "short", month: "short", day: "numeric" }).format(date);
  const [hours, minutes] = timeValue.split(":").map(Number);
  const timeLabel = new Intl.DateTimeFormat("en", { hour: "numeric", minute: "2-digit" }).format(new Date(2000, 0, 1, hours, minutes));
  return `${dateLabel} · ${timeLabel}`;
}

type TaskActivityAction = "Created" | "Assigned" | "Accepted" | "Declined" | "Reassigned" | "Completed" | "Reopened";

type TaskActivity = {
  id: string;
  action: TaskActivityAction;
  actor: string;
  detail: string;
  time: string;
};

function createInitialTaskActivity(task: CareTask): TaskActivity[] {
  const createdAt = new Date(Date.now() - (task.id * 5 + 10) * 60_000);
  const timestampAt = (minutesAfterCreation: number) => currentActivityTime(new Date(createdAt.getTime() + minutesAfterCreation * 60_000));
  const history: TaskActivity[] = [{
    id: `${task.id}-created`,
    action: "Created",
    actor: "Sarah Rivera",
    detail: "Added to the household delegation board",
    time: timestampAt(0),
  }];
  const owner = familyMembers.find((member) => member.name.split(" ")[0] === task.owner);

  if (owner) {
    history.push({ id: `${task.id}-assigned`, action: "Assigned", actor: "Sarah Rivera", detail: `Assigned to ${owner.name}`, time: timestampAt(5) });
  }
  if (task.status === "In progress" || task.complete) {
    history.push({ id: `${task.id}-accepted`, action: "Accepted", actor: owner?.name ?? task.owner, detail: "Accepted responsibility for this task", time: timestampAt(15) });
  }
  if (task.complete) {
    history.push({ id: `${task.id}-completed`, action: "Completed", actor: owner?.name ?? task.owner, detail: "Marked this task complete", time: timestampAt(25) });
  }
  return history;
}

function currentActivityTime(date = new Date()) {
  return new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", hour: "numeric", minute: "2-digit" }).format(date);
}

function CarePlanPage({ tasks, setTasks }: { tasks: CareTask[]; setTasks: React.Dispatch<React.SetStateAction<CareTask[]>> }) {
  const [searchParams] = useSearchParams();
  const requestedFilter = searchParams.get("filter");
  const [taskActivity, setTaskActivity] = useState<Record<number, TaskActivity[]>>(
    () => Object.fromEntries(tasks.map((task) => [task.id, createInitialTaskActivity(task)])),
  );
  const [activeFilter, setActiveFilter] = useState<TaskFilter>(() =>
    requestedFilter === "Unassigned" || requestedFilter === "Needs attention" ? requestedFilter : "All",
  );
  const [isTaskFiltersExpanded, setIsTaskFiltersExpanded] = useState(false);
  const [priorityFilter, setPriorityFilter] = useState<CareTask["priority"] | "All priorities">("All priorities");
  const [assigneeFilter, setAssigneeFilter] = useState("All assignees");
  const [atRiskOnly, setAtRiskOnly] = useState(false);
  const [dueSortDirection, setDueSortDirection] = useState<"earliest" | "latest">("earliest");
  const [selectedTaskId, setSelectedTaskId] = useState<number | null>(null);
  const [recommendationTaskId, setRecommendationTaskId] = useState<number | null>(null);
  const [isCreatingTask, setIsCreatingTask] = useState(false);
  const [newTaskTitle, setNewTaskTitle] = useState("");
  const [newTaskDetail, setNewTaskDetail] = useState("");
  const [newTaskLocation, setNewTaskLocation] = useState("");
  const [newTaskDate, setNewTaskDate] = useState(() => getLocalDateInputValue());
  const [newTaskTime, setNewTaskTime] = useState("18:00");
  const selectedTask = tasks.find((task) => task.id === selectedTaskId);
  const recommendationTask = tasks.find((task) => task.id === recommendationTaskId);

  const recordTaskActivity = (taskId: number, action: TaskActivityAction, detail: string, actor = "Sarah Rivera") => {
    const activity: TaskActivity = {
      id: `${taskId}-${Date.now()}-${Math.random()}`,
      action,
      actor,
      detail,
      time: currentActivityTime(),
    };
    setTaskActivity((current) => ({ ...current, [taskId]: [...(current[taskId] ?? []), activity] }));
  };

  const toggleTask = (taskId: number) => {
    const task = tasks.find((item) => item.id === taskId);
    if (!task) return;
    const complete = !task.complete;
    setTasks((current) => current.map((task) => {
      if (task.id !== taskId) return task;
      return { ...task, complete, status: complete ? "Completed" : task.owner === "Unassigned" ? "At risk" : "Open" };
    }));
    recordTaskActivity(taskId, complete ? "Completed" : "Reopened", complete ? "Marked this task complete" : "Reopened this task");
  };

  const assignTask = (taskId: number, owner: string) => {
    const previousTask = tasks.find((task) => task.id === taskId);
    if (!previousTask || previousTask.owner === owner) return;
    const member = familyMembers.find((person) => person.name.split(" ")[0] === owner);
    setTasks((current) => current.map((task) => {
      if (task.id !== taskId) return task;
      const unassigned = owner === "Unassigned" && !task.complete;
      return {
        ...task,
        owner,
        initials: member?.initials.slice(0, 1) ?? "?",
        attention: unassigned ? "Unassigned" : undefined,
        status: task.complete ? "Completed" : unassigned ? "Open" : "Open",
      };
    }));
    const assigned = owner !== "Unassigned";
    const action = assigned && previousTask.owner !== "Unassigned" ? "Reassigned" : "Assigned";
    recordTaskActivity(taskId, action, assigned ? `Assigned to ${member?.name ?? owner}` : "Returned to the unassigned queue");
  };

  const acceptTask = (taskId: number) => {
    const task = tasks.find((item) => item.id === taskId);
    if (!task || task.owner === "Unassigned" || task.complete) return;
    const actor = familyMembers.find((member) => member.name.split(" ")[0] === task.owner)?.name ?? task.owner;
    setTasks((current) => current.map((item) => item.id === taskId ? { ...item, status: "In progress", attention: undefined } : item));
    recordTaskActivity(taskId, "Accepted", "Accepted responsibility for this task", actor);
  };

  const declineTask = (taskId: number) => {
    const task = tasks.find((item) => item.id === taskId);
    if (!task || task.owner === "Unassigned" || task.complete) return;
    const actor = familyMembers.find((member) => member.name.split(" ")[0] === task.owner)?.name ?? task.owner;
    setTasks((current) => current.map((item) => item.id === taskId ? {
      ...item,
      owner: "Unassigned",
      initials: "?",
      attention: "Unassigned",
      status: "Open",
    } : item));
    recordTaskActivity(taskId, "Declined", "Declined the assignment and returned it to the unassigned queue", actor);
  };

  const createTask = (event: React.FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    const taskId = Math.max(0, ...tasks.map((task) => task.id)) + 1;
    const dueAt = new Date(`${newTaskDate}T${newTaskTime}`).toISOString();
    const task: CareTask = {
      id: taskId,
      title: newTaskTitle.trim(),
      detail: newTaskDetail.trim(),
      location: newTaskLocation.trim() || undefined,
      time: formatTaskDue(newTaskDate, newTaskTime),
      dueAt,
      owner: "Unassigned",
      initials: "?",
      category: "Check-in",
      complete: false,
      attention: "Unassigned",
      recipient: "Shared household",
      priority: "Normal",
      status: "At risk",
    };
    setTasks((current) => [...current, task]);
    setRecommendationTaskId(taskId);
    setNewTaskTitle("");
    setNewTaskDetail("");
    setNewTaskLocation("");
    setNewTaskDate(getLocalDateInputValue());
    setNewTaskTime("18:00");
    setIsCreatingTask(false);
    setActiveFilter("All");
    setPriorityFilter("All priorities");
    setAssigneeFilter("All assignees");
    setAtRiskOnly(false);
    setDueSortDirection("earliest");
    recordTaskActivity(taskId, "Created", "Added to the household delegation board");
  };

  const filterOptions: TaskFilter[] = ["All", "My Tasks", "Unassigned", "Needs attention", "Completed"];
  const riskEvaluatedAt = new Date();
  const riskAssessments = new Map(tasks.map((task) => [
    task.id,
    mockTaskRiskAssessment(task, tasks, familyMembers, riskEvaluatedAt),
  ]));
  const filterTasks = (filter: TaskFilter) => {
    switch (filter) {
      case "My Tasks": return tasks.filter((task) => task.owner === "Sarah" && !task.complete);
      case "Unassigned": return tasks.filter((task) => task.owner === "Unassigned" && !task.complete);
      case "Needs attention": return tasks.filter((task) => Boolean(task.attention) && !task.complete);
      case "Completed": return tasks.filter((task) => task.complete);
      default: return tasks.filter((task) => !task.complete);
    }
  };

  const countForFilter = (filter: TaskFilter) => filterTasks(filter).length;
  const visibleTasks = filterTasks(activeFilter);
  const canFilterTasks = activeFilter !== "Completed";
  const filteredTasks = canFilterTasks ? visibleTasks.filter((task) => {
    if (priorityFilter !== "All priorities" && task.priority !== priorityFilter) return false;
    if (assigneeFilter !== "All assignees" && task.owner !== assigneeFilter) return false;
    if (atRiskOnly && (riskAssessments.get(task.id)?.reasons.length ?? 0) === 0) return false;
    return true;
  }) : visibleTasks;
  const sortedTasks = [...filteredTasks].sort((first, second) => {
    const firstAtRisk = (riskAssessments.get(first.id)?.reasons.length ?? 0) > 0;
    const secondAtRisk = (riskAssessments.get(second.id)?.reasons.length ?? 0) > 0;
    if (firstAtRisk !== secondAtRisk) return firstAtRisk ? -1 : 1;
    if (first.complete !== second.complete) return first.complete ? 1 : -1;
    const firstDue = first.dueAt ? new Date(first.dueAt).getTime() : Number.POSITIVE_INFINITY;
    const secondDue = second.dueAt ? new Date(second.dueAt).getTime() : Number.POSITIVE_INFINITY;
    if (firstDue !== secondDue) {
      if (!Number.isFinite(firstDue)) return 1;
      if (!Number.isFinite(secondDue)) return -1;
      const direction = activeFilter === "Completed" || dueSortDirection === "earliest" ? 1 : -1;
      return direction * (firstDue - secondDue);
    }
    return first.id - second.id;
  });
  const hasTaskFilters = priorityFilter !== "All priorities" || assigneeFilter !== "All assignees" || atRiskOnly || dueSortDirection !== "earliest";
  const activeTaskFilterCount = Number(priorityFilter !== "All priorities") + Number(assigneeFilter !== "All assignees") + Number(atRiskOnly);

  return (
    <>
      <PageHeading title="Tasks" />
      <div className="mb-4 flex flex-wrap items-center justify-between gap-3">
        <p className="text-sm text-muted-foreground">{tasks.filter((task) => !task.complete).length} active · {tasks.filter((task) => task.complete).length} completed</p>
        <div className="flex items-center gap-3">
          <span className="hidden items-center gap-2 text-xs text-muted-foreground sm:inline-flex"><UsersRound size={15} aria-hidden="true" />Shared with {familyMembers.length} family members</span>
          <Button size="sm" onClick={() => setIsCreatingTask((current) => !current)}><Plus size={15} aria-hidden="true" />New task</Button>
        </div>
      </div>
      {isCreatingTask && (
        <Card className="mb-5">
          <CardHeader><div><p className="text-xs font-semibold uppercase tracking-[0.1em] text-primary">Household delegation</p><h2 className="mt-1 font-display text-xl font-semibold">Create a task</h2></div></CardHeader>
          <CardContent>
            <form onSubmit={createTask} className="grid gap-4 sm:grid-cols-2">
              <label className="text-sm font-medium sm:col-span-2">Task title
                <input required maxLength={100} value={newTaskTitle} onChange={(event) => setNewTaskTitle(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 font-normal focus:outline-none focus:ring-2 focus:ring-ring" />
              </label>
              <label className="text-sm font-medium sm:col-span-2">Details
                <input required maxLength={180} value={newTaskDetail} onChange={(event) => setNewTaskDetail(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 font-normal focus:outline-none focus:ring-2 focus:ring-ring" />
              </label>
              <label className="text-sm font-medium sm:col-span-2">Location <span className="font-normal text-muted-foreground">(optional)</span>
                <input maxLength={120} value={newTaskLocation} onChange={(event) => setNewTaskLocation(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 font-normal focus:outline-none focus:ring-2 focus:ring-ring" />
              </label>
              <label className="text-sm font-medium">Due date
                <input required type="date" min={getLocalDateInputValue()} value={newTaskDate} onChange={(event) => setNewTaskDate(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 font-normal focus:outline-none focus:ring-2 focus:ring-ring" />
              </label>
              <label className="text-sm font-medium">Time
                <input required type="time" value={newTaskTime} onChange={(event) => setNewTaskTime(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 font-normal focus:outline-none focus:ring-2 focus:ring-ring" />
              </label>
              <div className="flex items-end justify-end gap-2 sm:col-span-2">
                <Button type="button" variant="outline" onClick={() => setIsCreatingTask(false)}>Cancel</Button>
                <Button type="submit">Create task</Button>
              </div>
            </form>
          </CardContent>
        </Card>
      )}
      {recommendationTask && !recommendationTask.complete && (
        <FamilyAssignmentSuggestion
          className="mb-5"
          task={recommendationTask}
          tasks={tasks}
          members={familyMembers}
          onAssign={(owner) => {
            assignTask(recommendationTask.id, owner);
            setRecommendationTaskId(null);
          }}
        />
      )}
      <div role="tablist" aria-label="Filter care tasks" className="mb-4 flex gap-1 overflow-x-auto rounded-xl border border-border bg-muted/60 p-1">
        {filterOptions.map((filter) => (
          <button
            key={filter}
            type="button"
            role="tab"
            aria-selected={activeFilter === filter}
            aria-controls="tasks-panel"
            onClick={() => setActiveFilter(filter)}
            className={`flex shrink-0 items-center gap-2 rounded-lg px-3 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${activeFilter === filter ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground"}`}
          >
            {filter}<span className="text-xs opacity-70">{countForFilter(filter)}</span>
          </button>
        ))}
      </div>
      <Card className="overflow-hidden" aria-label={`${activeFilter} tasks`}>
        {canFilterTasks && (
          <div className="border-b border-border">
            <div className="flex items-center justify-between gap-3 bg-muted/20 px-4 py-2">
              <span className="text-xs text-muted-foreground">{sortedTasks.length} of {visibleTasks.length} tasks</span>
              <Button
                size="sm"
                variant="ghost"
                aria-expanded={isTaskFiltersExpanded}
                aria-controls="all-task-filters"
                onClick={() => setIsTaskFiltersExpanded((expanded) => !expanded)}
              >
                <SlidersHorizontal size={15} aria-hidden="true" />Filters
                {activeTaskFilterCount > 0 && <Badge variant="secondary" className="px-1.5 py-1 text-[10px]">{activeTaskFilterCount}</Badge>}
              </Button>
            </div>
            {isTaskFiltersExpanded && (
              <div id="all-task-filters" className="grid gap-3 bg-muted/30 p-4 sm:grid-cols-2 xl:grid-cols-[minmax(130px,1fr)_minmax(130px,1fr)_minmax(150px,1fr)_auto_auto] xl:items-end">
                <label className="text-xs font-semibold text-muted-foreground">Priority
                  <select value={priorityFilter} onChange={(event) => setPriorityFilter(event.target.value as CareTask["priority"] | "All priorities")} className="mt-1.5 min-h-9 w-full rounded-md border border-input bg-background px-3 text-sm font-normal text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
                    <option>All priorities</option>
                    <option>Urgent</option><option>High</option><option>Normal</option><option>Low</option>
                  </select>
                </label>
                <label className="text-xs font-semibold text-muted-foreground">Assignee
                  <select value={assigneeFilter} onChange={(event) => setAssigneeFilter(event.target.value)} className="mt-1.5 min-h-9 w-full rounded-md border border-input bg-background px-3 text-sm font-normal text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
                    <option value="All assignees">All assignees</option>
                    <option value="Unassigned">Unassigned</option>
                    {familyMembers.map((member) => <option key={member.name} value={member.name.split(" ")[0]}>{member.name.split(" ")[0]}</option>)}
                  </select>
                </label>
                <label className="text-xs font-semibold text-muted-foreground">Due order
                  <select value={dueSortDirection} onChange={(event) => setDueSortDirection(event.target.value as "earliest" | "latest")} className="mt-1.5 min-h-9 w-full rounded-md border border-input bg-background px-3 text-sm font-normal text-foreground focus:outline-none focus:ring-2 focus:ring-ring">
                    <option value="earliest">Earliest first</option>
                    <option value="latest">Latest first</option>
                  </select>
                </label>
                <label className="flex min-h-9 items-center gap-2 text-sm font-medium text-foreground">
                  <input type="checkbox" checked={atRiskOnly} onChange={(event) => setAtRiskOnly(event.target.checked)} className="size-4 accent-[hsl(var(--primary))]" />
                  At risk only
                </label>
                <Button size="sm" variant="outline" disabled={!hasTaskFilters} onClick={() => { setPriorityFilter("All priorities"); setAssigneeFilter("All assignees"); setAtRiskOnly(false); setDueSortDirection("earliest"); }}><RotateCcw size={14} aria-hidden="true" />Clear filters</Button>
              </div>
            )}
          </div>
        )}
        <div className="hidden grid-cols-[minmax(240px,1.6fr)_minmax(225px,1.35fr)_minmax(145px,1fr)_minmax(100px,0.8fr)] gap-3 border-b border-border bg-muted/40 px-5 py-3 text-[11px] font-semibold uppercase tracking-[0.1em] text-muted-foreground xl:grid">
          <span>Task and recipient</span><span>Assignment</span><span>Due</span><span>Priority</span>
        </div>
        <div id="tasks-panel" role="tabpanel" className="divide-y divide-border">
          {sortedTasks.map((task) => (
            <TaskListItem
              key={task.id}
              task={task}
              riskAssessment={riskAssessments.get(task.id)}
              onToggle={() => toggleTask(task.id)}
              onAssign={(owner) => assignTask(task.id, owner)}
              onOpen={() => setSelectedTaskId(task.id)}
            />
          ))}
          {sortedTasks.length === 0 && <p className="px-5 py-12 text-center text-sm text-muted-foreground">No tasks match these filters.</p>}
        </div>
      </Card>
      <p className="mt-3 text-xs text-muted-foreground">Changes are held in this session only.</p>
      {selectedTask && (
        <TaskDetailDialog
          task={selectedTask}
          activity={taskActivity[selectedTask.id] ?? []}
          onClose={() => setSelectedTaskId(null)}
          onAccept={() => acceptTask(selectedTask.id)}
          onDecline={() => declineTask(selectedTask.id)}
          onReassign={(owner) => assignTask(selectedTask.id, owner)}
          onComplete={() => toggleTask(selectedTask.id)}
        />
      )}
    </>
  );
}

type TaskFilter = "All" | "My Tasks" | "Unassigned" | "Needs attention" | "Completed";

function TaskListItem({
  task,
  riskAssessment,
  onToggle,
  onAssign,
  onOpen,
}: {
  task: CareTask;
  riskAssessment?: TaskRiskAssessment;
  onToggle: () => void;
  onAssign: (owner: string) => void;
  onOpen: () => void;
}) {
  const [selectedRiskAssignee, setSelectedRiskAssignee] = useState("");
  const recommendedOwner = riskAssessment?.suggestedMember?.name.split(" ")[0];
  const selectedOwner = selectedRiskAssignee || recommendedOwner || "";
  const isAtRisk = !task.complete && (riskAssessment?.reasons.length ?? 0) > 0;

  return (
    <article className={`grid gap-3 px-4 py-4 sm:grid-cols-2 xl:grid-cols-[minmax(240px,1.6fr)_minmax(225px,1.35fr)_minmax(145px,1fr)_minmax(100px,0.8fr)] xl:items-center xl:px-5 ${isAtRisk ? "border-l-4 border-l-warning bg-warning/20 pl-3" : task.complete ? "bg-muted/30" : ""}`}>
      <div className="flex min-w-0 items-start gap-3">
        <button
          type="button"
          onClick={onToggle}
          aria-label={`${task.complete ? "Reopen" : "Mark complete"}: ${task.title}`}
          aria-pressed={task.complete}
          className={`mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${task.complete ? "border-primary bg-primary text-primary-foreground" : "border-input bg-background hover:border-primary"}`}
        >
          {task.complete && <Check size={12} aria-hidden="true" />}
        </button>
        <div className="min-w-0">
          <button type="button" onClick={onOpen} className="text-left text-sm font-semibold hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            {task.title}
          </button>
          <button type="button" onClick={onOpen} className="mt-1 block text-xs font-medium text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">View details</button>
        </div>
      </div>
      <label className="min-w-0 text-xs text-muted-foreground">
        <span className="mb-1 block text-[10px] font-semibold uppercase tracking-[0.08em] xl:hidden">Assigned to</span>
        {riskAssessment?.suggestedMember && !task.complete ? (
          <div className="rounded-md bg-primary/5 p-2">
            <p className="mb-1.5 truncate text-[11px] font-semibold text-primary">Suggested: {recommendedOwner}</p>
            <div className="flex gap-1.5">
              <select
                aria-label={`Choose assignee for ${task.title}`}
                value={selectedOwner}
                onChange={(event) => setSelectedRiskAssignee(event.target.value)}
                className="min-w-0 flex-1 rounded-md border border-input bg-background px-2 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
              >
                {familyMembers.filter((member) => member.name.split(" ")[0] !== task.owner).map((member) => <option key={member.name} value={member.name.split(" ")[0]}>{member.name.split(" ")[0]}</option>)}
              </select>
              <Button size="sm" aria-label={`${task.owner === "Unassigned" ? "Assign" : "Reassign"} ${task.title} to ${selectedOwner}`} disabled={!selectedOwner || selectedOwner === task.owner} onClick={() => { onAssign(selectedOwner); setSelectedRiskAssignee(""); }}>
                {task.owner === "Unassigned" ? "Assign" : "Reassign"}
              </Button>
            </div>
          </div>
        ) : (
          <select
            aria-label={`Assign ${task.title}`}
            value={task.owner === "Unassigned" ? "Unassigned" : task.owner}
            onChange={(event) => onAssign(event.target.value)}
            className="w-full rounded-md border border-input bg-background px-2.5 py-2 text-sm text-foreground focus:outline-none focus:ring-2 focus:ring-ring"
          >
            <option value="Unassigned">Unassigned</option>
            {familyMembers.map((member) => <option key={member.name} value={member.name.split(" ")[0]}>{member.name.split(" ")[0]}</option>)}
          </select>
        )}
      </label>
      <div className="text-sm">
        <span className="mb-1 block text-[10px] font-semibold uppercase tracking-[0.08em] text-muted-foreground xl:hidden">Due</span>
        <span className="inline-flex items-center gap-1.5 text-foreground/80"><Clock3 size={14} aria-hidden="true" />{task.time}</span>
      </div>
      <div>
        <span className="mb-1 block text-[10px] font-semibold uppercase tracking-[0.08em] text-muted-foreground xl:hidden">Priority</span>
        <PriorityBadge priority={task.priority} />
        {riskAssessment && riskAssessment.reasons.length > 0 && (
          <ul className="mt-1.5 flex max-w-48 flex-wrap gap-1" aria-label={`Risk tags for ${task.title}`}>
            {riskAssessment.reasons.filter((reason) => reason.tag !== "Unavailable").map((reason) => (
              <li key={`${reason.tag}-${reason.label}`}>
                <Badge title={reason.label} className={`${taskRiskTagStyles[reason.tag]} whitespace-normal text-[10px]`} variant="outline">{reason.tag}</Badge>
              </li>
            ))}
          </ul>
        )}
      </div>
    </article>
  );
}

function PriorityBadge({ priority }: { priority: CareTask["priority"] }) {
  const styles = {
    Urgent: "border-alert bg-alert text-white",
    High: "border-primary bg-primary text-primary-foreground",
    Normal: "border-secondary-foreground/25 bg-secondary text-secondary-foreground",
    Low: "border-border bg-background text-muted-foreground",
  };
  return <Badge className={styles[priority]} variant="outline">{priority}</Badge>;
}

function TaskDetailDialog({
  task,
  activity,
  onClose,
  onAccept,
  onDecline,
  onReassign,
  onComplete,
}: {
  task: CareTask;
  activity: TaskActivity[];
  onClose: () => void;
  onAccept: () => void;
  onDecline: () => void;
  onReassign: (owner: string) => void;
  onComplete: () => void;
}) {
  const dialogRef = useRef<HTMLDialogElement>(null);
  const [isReassigning, setIsReassigning] = useState(false);
  const [selectedOwner, setSelectedOwner] = useState(task.owner === "Unassigned" ? "" : task.owner);

  useEffect(() => {
    const dialog = dialogRef.current;
    if (dialog && !dialog.open) dialog.showModal();
  }, []);

  const assignedMember = familyMembers.find((member) => member.name.split(" ")[0] === task.owner);
  const isAccepted = task.status === "In progress" || task.complete;
  const stages = [
    { label: "Created", complete: true, time: activity.find((item) => item.action === "Created")?.time, state: "In care plan" },
    { label: "Assigned", complete: task.owner !== "Unassigned", time: [...activity].reverse().find((item) => item.action === "Assigned" || item.action === "Reassigned")?.time, state: task.owner === "Unassigned" ? "Needs an owner" : `With ${assignedMember?.name.split(" ")[0] ?? task.owner}` },
    { label: "Accepted", complete: isAccepted, time: [...activity].reverse().find((item) => item.action === "Accepted")?.time, state: isAccepted ? "Responsibility accepted" : "Awaiting acceptance" },
    { label: "Completed", complete: task.complete, time: [...activity].reverse().find((item) => item.action === "Completed")?.time, state: task.complete ? "Finished" : "Not completed" },
  ];
  const activeResponse = task.owner !== "Unassigned" && !task.complete;

  return (
    <dialog
      ref={dialogRef}
      aria-labelledby="task-detail-title"
      onClose={onClose}
      onClick={(event) => { if (event.target === event.currentTarget) event.currentTarget.close(); }}
      className="fixed inset-0 m-auto max-h-[calc(100%-2rem)] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto rounded-xl border border-border bg-card p-0 text-foreground shadow-xl backdrop:bg-foreground/35"
    >
      <div className="p-5 sm:p-7">
        <div className="flex items-start justify-between gap-4 border-b border-border pb-5">
          <div className="min-w-0">
            <p className="text-xs font-semibold uppercase tracking-[0.1em] text-primary">Household delegation · Task view</p>
            <h2 id="task-detail-title" className="mt-2 font-display text-2xl font-semibold">{task.title}</h2>
            <p className="mt-2 text-sm leading-relaxed text-muted-foreground">{task.detail}</p>
          </div>
          <button autoFocus type="button" aria-label="Close task details" onClick={() => dialogRef.current?.close()} className="flex size-9 shrink-0 items-center justify-center rounded-full text-muted-foreground hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">
            <span aria-hidden="true">×</span>
          </button>
        </div>

        <section aria-label="Task responsibility" className="mt-5 flex flex-col gap-3 rounded-lg bg-primary/5 p-4 sm:flex-row sm:items-center">
          <div className="flex min-w-0 flex-1 items-center gap-3">
            {assignedMember ? <FamilyAvatar initials={assignedMember.initials} tone={assignedMember.tone} className="size-11" /> : <span className="flex size-11 shrink-0 items-center justify-center rounded-full bg-warning/30 text-sm font-semibold text-warning-foreground">?</span>}
            <div className="min-w-0">
              <p className="text-[10px] font-semibold uppercase tracking-[0.1em] text-muted-foreground">Assigned family member</p>
              <p className="mt-0.5 truncate text-base font-semibold">{assignedMember?.name ?? "Unassigned"}</p>
              {assignedMember && <p className="text-xs text-muted-foreground">{assignedMember.role}</p>}
            </div>
          </div>
          <div className="flex flex-wrap items-center gap-2 sm:justify-end">
            <PriorityBadge priority={task.priority} />
          </div>
        </section>

        <dl className="mt-5 grid grid-cols-2 gap-x-5 gap-y-4 border-b border-border pb-5 text-sm sm:grid-cols-4">
          <div><dt className="text-xs text-muted-foreground">Delegation focus</dt><dd className="mt-1 font-medium">{task.recipient}</dd></div>
          <div><dt className="text-xs text-muted-foreground">Due date &amp; time</dt><dd className="mt-1 inline-flex items-center gap-1.5 font-medium"><Clock3 size={14} aria-hidden="true" />{task.time}</dd></div>
          <div><dt className="text-xs text-muted-foreground">Location</dt><dd className="mt-1 inline-flex items-center gap-1.5 font-medium"><MapPin size={14} aria-hidden="true" />{task.location || "Not specified"}</dd></div>
          <div><dt className="text-xs text-muted-foreground">Category</dt><dd className="mt-1 font-medium">{task.category}</dd></div>
        </dl>

        <div className="mt-5 grid gap-6 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
          <section aria-labelledby="task-timeline-heading">
            <h3 id="task-timeline-heading" className="font-display text-lg font-semibold">Task timeline</h3>
            <ol className="mt-4 space-y-0">
              {stages.map((stage, index) => (
                <li key={stage.label} className="relative flex min-h-14 gap-3 pb-3 last:min-h-0 last:pb-0">
                  {index < stages.length - 1 && <span aria-hidden="true" className={`absolute left-[11px] top-6 h-8 border-l ${stage.complete ? "border-primary/50" : "border-border"}`} />}
                  <span className={`relative mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full border ${stage.complete ? "border-primary bg-primary text-primary-foreground" : "border-border bg-background text-muted-foreground"}`}>
                    {stage.complete ? <Check size={13} aria-hidden="true" /> : <span className="size-1.5 rounded-full bg-current" />}
                  </span>
                  <div className="flex min-w-0 flex-1 items-start justify-between gap-2">
                    <div><p className={`text-sm font-semibold ${stage.complete ? "text-foreground" : "text-muted-foreground"}`}>{stage.label}</p><p className="mt-0.5 text-xs text-muted-foreground">{stage.state}</p></div>
                    <span className="shrink-0 text-[11px] text-muted-foreground">{stage.complete ? stage.time ?? "Timestamp unavailable" : "—"}</span>
                  </div>
                </li>
              ))}
            </ol>
          </section>

          <section aria-labelledby="task-history-heading">
            <h3 id="task-history-heading" className="font-display text-lg font-semibold">Activity history</h3>
            <ol className="mt-3 divide-y divide-border border-y border-border">
              {[...activity].reverse().map((item) => (
                <li key={item.id} className="grid grid-cols-[1fr_auto] gap-x-3 gap-y-1 py-3">
                  <p className="text-sm font-semibold">{item.actor}</p>
                  <time className="text-right text-[11px] text-muted-foreground">{item.time}</time>
                  <p className="col-span-2 text-xs leading-relaxed text-muted-foreground"><span className="font-semibold text-foreground/80">{item.action}.</span> {item.detail}</p>
                </li>
              ))}
            </ol>
          </section>
        </div>

        <section aria-label="Task actions" className="mt-6 border-t border-border pt-4">
          <div className="flex flex-wrap gap-2">
            <Button size="sm" disabled={!activeResponse || isAccepted} onClick={onAccept}>Accept task</Button>
            <Button size="sm" variant="outline" disabled={!activeResponse} onClick={onDecline}>Decline task</Button>
            <Button size="sm" variant="outline" disabled={task.complete} onClick={() => { setSelectedOwner(task.owner === "Unassigned" ? "" : task.owner); setIsReassigning((current) => !current); }}>Reassign</Button>
            <Button size="sm" variant={task.complete ? "outline" : "default"} onClick={onComplete}>{task.complete ? "Reopen task" : "Mark complete"}</Button>
          </div>
          {isReassigning && (
            <div className="mt-3 flex flex-col gap-2 rounded-lg bg-muted/50 p-3 sm:flex-row">
              <label className="sr-only" htmlFor={`reassign-task-${task.id}`}>Assign to family member</label>
              <select
                id={`reassign-task-${task.id}`}
                value={selectedOwner}
                onChange={(event) => setSelectedOwner(event.target.value)}
                className="min-h-9 min-w-0 flex-1 rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring"
              >
                <option value="">Select a family member</option>
                {familyMembers.map((member) => <option key={member.name} value={member.name.split(" ")[0]}>{member.name}</option>)}
              </select>
              <Button size="sm" disabled={!selectedOwner || selectedOwner === task.owner} onClick={() => { onReassign(selectedOwner); setIsReassigning(false); }}>Save assignment</Button>
              <Button size="sm" variant="ghost" onClick={() => setIsReassigning(false)}>Cancel</Button>
            </div>
          )}
        </section>
      </div>
    </dialog>
  );
}

function AppointmentsPage() {
  return (
    <>
      <PageHeading title="Appointments" />
      <Card className="px-5 md:px-7" aria-label="Upcoming appointments">
        <div className="flex items-center gap-3 border-b border-border py-5">
          <span className="flex size-10 items-center justify-center rounded-lg bg-accent text-accent-foreground"><CalendarDays size={19} aria-hidden="true" /></span>
          <div><h2 className="font-display text-lg font-semibold">Today</h2><p className="text-xs text-muted-foreground">Tuesday, September 29</p></div>
        </div>
        <div className="divide-y divide-border">
          {careAppointments.map((appointment) => (
            <div key={appointment.id} className="grid gap-3 py-5 sm:grid-cols-[92px_1fr_auto] sm:items-center">
              <p className="text-sm font-semibold text-primary">{appointment.time}</p>
              <div className="flex items-start gap-3">
                <span className="mt-0.5 flex size-9 items-center justify-center rounded-lg bg-secondary text-secondary-foreground"><Stethoscope size={17} aria-hidden="true" /></span>
                <div><h3 className="text-sm font-semibold">{appointment.title}</h3><p className="mt-1 flex items-center gap-1 text-xs text-muted-foreground"><MapPin size={13} aria-hidden="true" />{appointment.place}</p></div>
              </div>
              <Badge variant="secondary">{appointment.person} is going</Badge>
            </div>
          ))}
        </div>
      </Card>
    </>
  );
}

function ActivityPage() {
  return (
    <>
      <PageHeading title="Activity" />
      <ActivityCard />
    </>
  );
}

function CareCirclePage({ familyName, onSaveFamilyName }: { familyName: string; onSaveFamilyName: (name: string) => void }) {
  const [members, setMembers] = useState(familyMembers);
  const [isEditingMembers, setIsEditingMembers] = useState(false);
  const [isAddingMember, setIsAddingMember] = useState(false);
  const [familyNameDraft, setFamilyNameDraft] = useState(familyName);
  const [newMemberName, setNewMemberName] = useState("");
  const [newMemberRole, setNewMemberRole] = useState("Family member");
  const [newMemberAvailability, setNewMemberAvailability] = useState<(typeof familyMembers)[number]["availability"]>("Available");
  const isOwner = true; // Prototype admin/owner role; gate behind auth in future sign-in implementation.

  const handleAddMember = (event: React.FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    const trimmedName = newMemberName.trim();
    if (!trimmedName) return;

    const [firstName, ...rest] = trimmedName.split(" ");
    const lastName = rest.join(" ");
    const initials = `${firstName.charAt(0) ?? ""}${lastName.charAt(0) ?? ""}`.toUpperCase() || "F";

    setMembers((current) => [
      ...current,
      {
        name: trimmedName,
        role: newMemberRole.trim() || "Family member",
        initials,
        availability: newMemberAvailability,
        tone: current.length % 2 === 0 ? "sage" : "coral",
      },
    ]);

    setNewMemberName("");
    setNewMemberRole("Family member");
    setNewMemberAvailability("Available");
    setIsAddingMember(false);
  };

  const handleRemoveMember = (memberName: string) => {
    setMembers((current) => current.filter((member) => member.name !== memberName));
  };

  return (
    <>
      <PageHeading title="Family" />
      <Card>
        <CardHeader className="items-center">
          <div><p className="text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">Family team</p><h2 className="mt-1 font-display text-xl font-semibold">Members</h2></div>
          {isOwner && (
            <Button variant="outline" size="sm" onClick={() => { setIsEditingMembers((current) => !current); setIsAddingMember(false); }}>
              {isEditingMembers ? "Done" : "Edit"}
            </Button>
          )}
        </CardHeader>
        <CardContent className="pt-3">
          {isEditingMembers && (
            <>
              <div className="mb-5 grid gap-3 rounded-lg border border-border bg-muted/20 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end">
                <label className="min-w-0 text-sm font-medium">Family name
                  <input maxLength={40} value={familyNameDraft} onChange={(event) => setFamilyNameDraft(event.target.value)} className="mt-1.5 h-10 w-full rounded-md border border-input bg-background px-3 text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                </label>
                <div className="grid gap-2 sm:flex sm:items-center">
                  <Button type="button" size="sm" disabled={!familyNameDraft.trim() || familyNameDraft.trim() === familyName} onClick={() => onSaveFamilyName(familyNameDraft)}>Save family name</Button>
                  <Button type="button" size="sm" variant="outline" onClick={() => setIsAddingMember((current) => !current)}>
                    {isAddingMember ? "Cancel add" : "Add member"}
                  </Button>
                </div>
              </div>
              {isAddingMember && (
                <form onSubmit={handleAddMember} className="mb-5 grid gap-3 rounded-lg border border-border bg-muted/20 p-4 md:grid-cols-4">
                  <label className="text-sm font-medium md:col-span-2">
                    Full name
                    <input required value={newMemberName} onChange={(event) => setNewMemberName(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                  </label>
                  <label className="text-sm font-medium">
                    Role
                    <input value={newMemberRole} onChange={(event) => setNewMemberRole(event.target.value)} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring" />
                  </label>
                  <label className="text-sm font-medium">
                    Availability
                    <select value={newMemberAvailability} onChange={(event) => setNewMemberAvailability(event.target.value as (typeof familyMembers)[number]["availability"])} className="mt-1.5 w-full rounded-md border border-input bg-background px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-ring">
                      <option value="Available">Available</option>
                      <option value="Away today">Away today</option>
                      <option value="On duty">On duty</option>
                      <option value="With family">With family</option>
                    </select>
                  </label>
                  <div className="flex items-end justify-end gap-2 md:col-span-4">
                    <Button type="button" variant="outline" onClick={() => { setIsAddingMember(false); setNewMemberName(""); }}>Cancel</Button>
                    <Button type="submit">Save member</Button>
                  </div>
                </form>
              )}
            </>
          )}

          <div className="divide-y divide-border">
          {members.map((member) => (
            <div key={member.name} className="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-x-4 gap-y-1 py-4 sm:px-2">
              <div className="flex min-w-0 items-center gap-3">
                {isEditingMembers && (
                  <button
                    type="button"
                    aria-label={`Remove ${member.name}`}
                    onClick={() => handleRemoveMember(member.name)}
                    className="flex size-5 shrink-0 items-center justify-center rounded-full border border-destructive bg-destructive/10 text-xs font-bold text-destructive hover:bg-destructive/20"
                  >
                    −
                  </button>
                )}
                <FamilyAvatar initials={member.initials} tone={member.tone} className="size-10" />
                <div className="min-w-0 flex-1">
                  <p className="truncate text-sm font-semibold">{member.name}</p>
                  <p className="text-xs text-muted-foreground">{member.role}</p>
                  <FamilyWorkloadBar name={member.name} activeTasks={getFamilyWorkload(member.name)} />
                </div>
              </div>
            </div>
          ))}
          </div>
        </CardContent>
      </Card>
    </>
  );
}

function ActivityCard() {
  return (
    <Card>
      <CardHeader><div><p className="text-xs font-semibold uppercase tracking-[0.1em] text-muted-foreground">Latest family updates</p><h2 className="mt-1 font-display text-xl font-semibold">Family activity</h2></div><ActivityIcon size={18} className="mt-1 text-primary" aria-hidden="true" /></CardHeader>
      <CardContent className="space-y-4 pt-4">
        {careActivity.map((item) => (
          <div key={item.id} className="flex gap-3">
            <FamilyAvatar initials={item.initials} tone={item.tone} className="size-8" />
            <div className="min-w-0 flex-1"><p className="text-xs leading-relaxed"><span className="font-semibold">{item.person}</span> {item.action} <span className="font-semibold">{item.subject}</span></p><p className="mt-1 text-[11px] text-muted-foreground">{item.time}</p></div>
          </div>
        ))}
      </CardContent>
    </Card>
  );
}

function TaskRow({ task, compact = false, onToggle }: { task: CareTask; compact?: boolean; onToggle?: () => void }) {
  return (
    <div className={`grid grid-cols-[1fr_auto] items-center gap-3 py-4 md:grid-cols-[1fr_130px_120px] ${task.complete ? "opacity-60" : ""}`}>
      <div className="flex min-w-0 items-center gap-3">
        {onToggle ? (
          <button
            type="button"
            onClick={onToggle}
            aria-label={`${task.complete ? "Mark incomplete" : "Mark complete"}: ${task.title}`}
            aria-pressed={task.complete}
            className={`flex size-5 shrink-0 items-center justify-center rounded-full border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${task.complete ? "border-primary bg-primary text-primary-foreground" : "border-input bg-background hover:border-primary"}`}
          >
            {task.complete && <Check size={12} aria-hidden="true" />}
          </button>
        ) : (
          <span className={`flex size-8 shrink-0 items-center justify-center rounded-full ${task.complete ? "bg-accent text-accent-foreground" : "bg-secondary text-secondary-foreground"}`}>
            {task.complete ? <Check size={15} aria-hidden="true" /> : <Clock3 size={15} aria-hidden="true" />}
          </span>
        )}
        <div className="min-w-0">
          <p className={`truncate text-sm font-semibold ${task.complete ? "line-through" : ""}`}>{task.title}</p>
          <p className="mt-0.5 truncate text-xs text-muted-foreground">{compact ? task.detail : `${task.category} · ${task.detail}`}</p>
          <p className="mt-1 text-xs text-muted-foreground md:hidden">{task.owner} · {task.time}</p>
        </div>
      </div>
      <span className="hidden items-center gap-2 text-sm text-muted-foreground md:flex">
        <span className="flex size-7 items-center justify-center rounded-full bg-muted text-xs font-semibold text-foreground">{task.initials}</span>
        {task.owner}
      </span>
      <span className="whitespace-nowrap text-right text-sm font-medium text-muted-foreground">{task.time}</span>
    </div>
  );
}

export default function App() {
  return <AppShell />;
}