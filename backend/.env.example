APP_NAME=CareCircle API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_USER=familycare
POSTGRES_DB=family_care
# SQLite file under backend/; no database server needed.
DATABASE_URL=sqlite:///data/app.db
# To use the Docker PostgreSQL service instead (docker compose up -d db), swap to:
# DATABASE_URL=postgresql+psycopg://familycare@localhost:5432/family_care
SESSION_COOKIE_NAME=family_session
SESSION_LIFETIME_SECONDS=2592000
SESSION_COOKIE_SECURE=false
CHROMA_PERSIST_DIR=./data/chroma
# Key for the AI features (assignment suggestions). Create one at https://platform.openai.com/api-keys and paste it
# in backend/.env only. Leave it blank here: this file is committed to git.
OPENAI_API_KEY=
# Model used for AI features.
LLM_MODEL=gpt-6-astra
# Token for the Telegram bot (overdue reminders and adding tasks from messages). Create a bot with @BotFather in
# Telegram and paste its token in backend/.env only. Leave it blank here. Without it the app runs with no bot.
TELEGRAM_BOT_TOKEN=
