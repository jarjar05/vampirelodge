APP_NAME=CareCircle API
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
# SQLite file under backend/; no database server needed.
DATABASE_URL=sqlite:///data/app.db
SESSION_COOKIE_NAME=family_session
SESSION_LIFETIME_SECONDS=2592000
SESSION_COOKIE_SECURE=false
CHROMA_PERSIST_DIR=./data/chroma
# Key for the AI features (assignment suggestions). Create one at https://platform.openai.com/api-keys and paste it
# in backend/.env only. Leave it blank here: this file is committed to git.
OPENAI_API_KEY=
# Model used for AI features.
LLM_MODEL=gpt-6-astra
# Token for the Telegram bot (overdue reminders and adding tasks from messages). Create a bot with @BotFather in
# Telegram and paste its token in backend/.env only. Leave it blank here. Without it the app runs with no bot.
TELEGRAM_BOT_TOKEN=
# Only for checking the app against your Supabase database before it goes live (scripts/test-postgres.sh). The tests
# wipe that database, so use it only while it is empty. Use the Transaction pooler address (port 6543).
SUPABASE_DATABASE_URL=
# On Vercel only (set in Vercel's settings, not here): TELEGRAM_WEBHOOK_SECRET, a long random string Telegram sends
# with every message so the app knows it is really Telegram. PUBLIC_URL is the site's address if it is not the
# Vercel production one. See docs/deploying.md.
